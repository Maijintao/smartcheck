{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "assemble-debug-smartcheck",
			"type": "shell",
			"command": ".\\gradlew.bat",
			"args": [
				":app:assembleDebug",
				"--console=plain"
			],
			"isBackground": false
		},
		{
			"label": "compile-debug-kotlin-stacktrace",
			"type": "shell",
			"command": ".\\gradlew.bat",
			"args": [
				":app:compileDebugKotlin",
				"--stacktrace",
				"--console=plain"
			],
			"isBackground": false
		},
		{
			"label": "assemble-debug-smartcheck-retry",
			"type": "shell",
			"command": ".\\gradlew.bat",
			"args": [
				":app:assembleDebug",
				"--console=plain",
				"--no-daemon"
			],
			"isBackground": false
		}
	]
}